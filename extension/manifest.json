{
  "manifest_version": 3,
  "name": "Paint It Black",
  "version": "1.0.0",
  "description": "Tailor your local LaTeX resume to any job description using local AI CLIs (Antigravity, Claude Code, Codex) or your own API key on Windows (WSL) or macOS.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Paint It Black",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "contextMenus",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-resume-tailor": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open the Paint It Black side panel"
    }
  }
}
